# ── Admin panel ────────────────────────────────────────────────
ADMIN_PASSWORD=
TOKEN_SECRET=

# ── Shared infra (same values as vinsfins — single source of truth) ──
# Vercel Blob — wine data + static content (vinsfins-prefixed "wines" blob is authoritative)
BLOB_READ_WRITE_TOKEN=

# Vercel KV (Redis) — atomic stock + rate limits + webhook idempotency
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Stripe (same account as vinsfins) ──────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Per-endpoint secret — register a SEPARATE webhook endpoint for grocerie
# in the Stripe dashboard (https://<grocerie-domain>/api/webhook) and use
# the secret Stripe issues for it (different from vinsfins's).
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Luxembourg VAT rate ID (create in Stripe and paste txr_ id)
STRIPE_VAT_RATE_LU=
# Optional — enable Stripe Tax (automatic_tax)
STRIPE_AUTOMATIC_TAX=false

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=La Grocerie <commandes@lagrocerie.lu>
ADMIN_EMAIL=info@lagrocerie.lu

# ── Site URL (used for Stripe redirects) ───────────────────────
NEXT_PUBLIC_SITE_URL=https://lagrocerie.lu
